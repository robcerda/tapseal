/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://oauth2.googleapis.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cache-Control: no-store
  Permissions-Policy: publickey-credentials-get=(self), publickey-credentials-create=(self), camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow
  Cross-Origin-Opener-Policy: same-origin
